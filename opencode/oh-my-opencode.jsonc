{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": true,
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "high"
    },
    "librarian": {
      "model": "github-copilot/claude-sonnet-4.5"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "frontend-ui-ux-engineer": {
      "model": "google/antigravity-gemini-3-pro"
    },
    "document-writer": {
      "model": "google/antigravity-gemini-3-flash"
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-3-flash"
    },
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "variant": "medium"
    },
    "explore": {
      "model": "github-copilot/gpt-5-mini"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "medium"
    },
    "atlas": {
      "model": "github-copilot/claude-sonnet-4.5"
    }
  },
  "sisyphus_agent": {
    "default_builder_enabled": true,
    "replace_plan": false
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gemini-3-pro",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.4",
      "variant": "medium"
    },
    "artistry": {
      "model": "github-copilot/gemini-3-pro",
      "variant": "high"
    },
    "quick": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "unspecified-low": {
      "model": "github-copilot/claude-sonnet-4.5"
    },
    "unspecified-high": {
      "model": "github-copilot/claude-sonnet-4.5"
    },
    "writing": {
      "model": "github-copilot/gemini-3-flash"
    }
  },
  "_migrations": [
    "model-version:openai/gpt-5.3-codex->openai/gpt-5.4"
  ]
}